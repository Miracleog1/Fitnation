<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0a0a0a">
<title>FitNation — Get Fit, Live Better</title>
<meta name="description" content="FitNation gym: memberships, classes, trainers and merch. Join today.">

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- ============================================================
     SNIPCART — powers the real shopping cart & checkout below.
     Snipcart connects to Stripe/PayPal for you with zero backend.
     1) Create a free account at https://snipcart.com
     2) Get your PUBLIC API key from Dashboard > Account > API Keys
     3) Replace YOUR_SNIPCART_PUBLIC_API_KEY below
     ============================================================ -->
<link rel="preconnect" href="https://app.snipcart.com">
<link rel="preconnect" href="https://cdn.snipcart.com">
<link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.css" />

<style>
  :root{
    --bg:#0a0a0a;
    --bg-card:#141414;
    --bg-card-alt:#1b1b1b;
    --line: rgba(255,255,255,0.08);
    --lime:#9EFF1F;
    --lime-dim:#7ACC00;
    --white:#f5f5f5;
    --muted:#9a9a9a;
    --muted-2:#707070;
    --radius: 18px;
    --wrap: 1200px;
    --font-head: 'Sora', sans-serif;
    --font-body: 'Inter', sans-serif;
  }
  /* ============================================================
     CODE MAP — jump to a section by searching its comment below:
     NAV        → header / mobile menu
     HERO       → top banner
     SERVICES   → "Transform Your Fitness Journey"
     FACILITY   → gym carousel + location
     PLANS      → membership pricing / Stripe checkout
     SCHEDULE   → class timetable
     TRAINERS   → coach grid
     SHOP       → merch cards / Snipcart cart
     TESTIMONIALS, FAQ, CONTACT, FINAL CTA, FOOTER
     Each block below is self-contained: edit colors/spacing for one
     section without touching the others.
     ============================================================ */
  *{margin:0;padding:0;box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html{scroll-behavior:smooth; -webkit-text-size-adjust:100%;}
  body{
    background:var(--bg);
    color:var(--white);
    font-family:var(--font-body);
    line-height:1.6;
    overflow-x:hidden;
    width:100%;
  }
  /* Touch targets: keep every tappable control at least 44px tall on
     any screen — the mobile OS accessibility minimum. */
  button, a.btn, .icon-btn, input, textarea{ min-height:44px; }
  .icon-btn{ min-width:44px; }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }
  img{max-width:100%; display:block;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}
  .wrap{max-width:var(--wrap); margin:0 auto; padding:0 24px;}
  h1,h2,h3,h4{font-family:var(--font-head); font-weight:700; letter-spacing:-0.02em; line-height:1.08;}
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:12px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--lime); margin-bottom:14px;
  }
  .eyebrow::before{content:""; width:8px; height:8px; border-radius:50%; background:var(--lime); box-shadow:0 0 12px var(--lime);}
  .section{padding:100px 0;}
  @media (max-width:768px){ .section{padding:64px 0;} }
  .section-head{display:flex; justify-content:space-between; align-items:flex-end; gap:32px; margin-bottom:48px; flex-wrap:wrap;}
  .section-head p{color:var(--muted); max-width:420px; font-size:15px;}
  .section-head h2{font-size:clamp(28px,4vw,42px);}

  /* Buttons */
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:10px;
    padding:14px 26px; border-radius:100px; font-weight:600; font-size:14.5px;
    border:1px solid transparent; cursor:pointer; transition:transform .18s ease, box-shadow .18s ease, background .18s ease;
    font-family:var(--font-body); white-space:nowrap;
  }
  .btn:active{transform:scale(0.97);}
  .btn-lime{background:var(--lime); color:#0a0a0a;}
  .btn-lime:hover{box-shadow:0 8px 24px rgba(158,255,31,0.35); transform:translateY(-2px);}
  .btn-outline{border-color:rgba(255,255,255,0.25); color:var(--white); background:transparent;}
  .btn-outline:hover{border-color:var(--lime); color:var(--lime);}
  .btn-block{width:100%;}

  /* NAV */
  header{
    position:sticky; top:0; z-index:1000;
    background:rgba(10,10,10,0.85); backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
  }
  .nav{display:flex; align-items:center; justify-content:space-between; padding:18px 24px;}
  .logo{display:flex; align-items:center; gap:10px; font-family:var(--font-head); font-weight:800; font-size:20px;}
  .logo .mark{
    width:34px; height:34px; border-radius:9px; background:var(--lime);
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .logo .mark svg{width:20px; height:20px;}
  .logo small{display:block; font-family:var(--font-body); font-weight:600; font-size:8px; letter-spacing:0.12em; color:var(--muted); text-transform:uppercase; margin-top:-2px;}
  .nav-links{display:flex; align-items:center; gap:36px; font-size:14.5px; font-weight:500;}
  .nav-links a{color:#d8d8d8; transition:color .15s;}
  .nav-links a:hover{color:var(--lime);}
  .nav-right{display:flex; align-items:center; gap:14px;}
  .icon-btn{
    width:40px; height:40px; border-radius:50%; border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center; background:transparent; cursor:pointer; color:var(--white);
  }
  .icon-btn:hover{border-color:var(--lime); color:var(--lime);}
  .burger{display:none; flex-direction:column; gap:5px; width:26px; cursor:pointer; background:none; border:none;}
  .burger span{height:2px; background:var(--white); border-radius:2px; transition:.2s;}
  .mobile-menu{
    display:none; flex-direction:column; gap:2px; padding:8px 24px 20px;
    background:var(--bg); border-bottom:1px solid var(--line);
  }
  .mobile-menu a{padding:14px 4px; border-bottom:1px solid var(--line); font-size:15px;}
  @media (max-width:900px){
    .nav-links{display:none;}
    .burger{display:flex;}
  }
  @media (max-width:480px){
    /* Nav gets crowded at phone widths: cart, Join Now, and burger all
       compete for space — drop the button label and keep the icons. */
    .nav{padding:14px 16px;}
    .nav-right .btn{padding:0; width:44px; height:44px; border-radius:50%; font-size:0;}
    .nav-right .btn::after{content:"→"; font-size:16px;}
    .logo{font-size:17px; gap:8px;}
    .logo .mark{width:30px; height:30px;}
    .logo small{font-size:7px;}
  }

  /* HERO */
  .hero{position:relative; overflow:hidden; padding-top:70px;}
  .hero-grid{
    display:grid; grid-template-columns:1.1fr 1fr; gap:20px; align-items:stretch;
    min-height:640px;
  }
  .hero-copy{padding:70px 8px 40px 0; display:flex; flex-direction:column; justify-content:center; gap:22px;}
  .hero-copy h1{font-size:clamp(36px,5.6vw,60px);}
  .hero-copy h1 span{color:var(--lime);}
  .hero-copy p{color:var(--muted); max-width:420px; font-size:16px;}
  .hero-cta{display:flex; gap:14px; align-items:center; flex-wrap:wrap;}
  .price-pill{
    background:transparent; border:1px solid rgba(255,255,255,0.25);
    padding:14px 10px 14px 22px; border-radius:100px; display:flex; align-items:center; gap:10px;
  }
  .price-pill b{background:var(--lime); color:#0a0a0a; border-radius:100px; padding:8px 14px; font-size:13px; font-weight:700;}
  .hero-social{display:flex; align-items:center; gap:14px; margin-top:6px;}
  .avatars{display:flex;}
  .avatars img{width:36px; height:36px; border-radius:50%; border:2px solid var(--bg); object-fit:cover; margin-left:-10px;}
  .avatars img:first-child{margin-left:0;}
  .hero-social .stat b{font-family:var(--font-head); font-size:20px; display:block;}
  .hero-social .stat span{font-size:12px; color:var(--muted);}
  .hero-img-wrap{position:relative; border-radius:var(--radius); overflow:hidden;}
  .hero-img-wrap img{width:100%; height:100%; object-fit:cover; min-height:420px;}
  .hero-img-wrap::after{
    content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(10,10,10,0) 40%, rgba(10,10,10,0.55) 100%);
  }
  @media (max-width:900px){
    .hero-grid{grid-template-columns:1fr; min-height:auto;}
    .hero-copy{padding:36px 0 8px;}
    .hero-img-wrap img{min-height:280px;}
  }

  /* TRANSFORM / SERVICES */
  .services-grid{display:grid; grid-template-columns:1.6fr repeat(3,1fr); gap:18px;}
  .service-card{
    position:relative; border-radius:var(--radius); overflow:hidden; min-height:420px;
    background:var(--bg-card); display:flex; flex-direction:column; justify-content:flex-end;
  }
  .service-card img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.85; transition:transform .5s ease;}
  .service-card:hover img{transform:scale(1.06);}
  .service-card::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(10,10,10,0.05) 30%, rgba(10,10,10,0.92) 100%);}
  .service-tag{
    position:absolute; top:16px; left:16px; z-index:2; width:40px; height:40px; border-radius:10px;
    background:var(--lime); display:flex; align-items:center; justify-content:center; color:#0a0a0a;
  }
  .service-body{position:relative; z-index:2; padding:22px;}
  .service-body h3{font-size:20px; margin-bottom:6px;}
  .service-body p{font-size:13.5px; color:#cfcfcf; max-width:260px;}
  .service-card.vertical{min-height:420px;}
  .service-card.vertical .service-body h3{
    writing-mode:vertical-rl; transform:rotate(180deg); font-size:15px; letter-spacing:0.1em; text-transform:uppercase; height:120px;
  }
  @media (max-width:960px){
    .services-grid{grid-template-columns:1fr 1fr;}
    .service-card{min-height:320px;}
  }
  @media (max-width:600px){ .services-grid{grid-template-columns:1fr;} }

  /* COMFORTABLE GYM / LOCATION */
  .gym-grid{display:grid; grid-template-columns:1fr 1.2fr; gap:24px; align-items:center;}
  .gym-copy p{color:var(--muted); margin:14px 0 26px; max-width:340px;}
  .carousel-controls{display:flex; gap:10px; margin-bottom:20px;}
  .carousel-btn{
    width:44px; height:44px; border-radius:50%; border:1px solid var(--line); background:transparent;
    display:flex; align-items:center; justify-content:center; color:var(--white); cursor:pointer;
  }
  .carousel-btn:hover{background:var(--lime); border-color:var(--lime); color:#0a0a0a;}
  .carousel-frame{border-radius:var(--radius); overflow:hidden; aspect-ratio:4/3;}
  .carousel-frame img{width:100%; height:100%; object-fit:cover; transition:opacity .4s ease;}
  .location-card{
    position:relative; border-radius:var(--radius); overflow:hidden; min-height:360px;
    background:var(--bg-card); display:flex; flex-direction:column; justify-content:flex-end;
  }
  .location-card img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover;}
  .location-card::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(10,10,10,0.1) 30%, rgba(10,10,10,0.9) 100%);}
  .location-pin{position:absolute; top:18px; right:18px; z-index:2; width:42px; height:42px; border-radius:12px; background:var(--lime); display:flex; align-items:center; justify-content:center; color:#0a0a0a;}
  .location-body{position:relative; z-index:2; padding:24px; display:flex; justify-content:space-between; align-items:flex-end; gap:16px; flex-wrap:wrap;}
  .location-body h3{font-size:22px;}
  .location-body address{font-style:normal; font-size:13.5px; color:#cfcfcf; text-align:right;}
  @media (max-width:860px){ .gym-grid{grid-template-columns:1fr;} }

  /* MEMBERSHIP PLANS */
  .plans-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  .plan-card{
    background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius);
    padding:34px 28px; display:flex; flex-direction:column; gap:20px; position:relative;
  }
  .plan-card.featured{border-color:var(--lime); background:linear-gradient(180deg, rgba(158,255,31,0.08), var(--bg-card) 40%);}
  .plan-badge{
    position:absolute; top:-13px; right:28px; background:var(--lime); color:#0a0a0a;
    font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; padding:6px 14px; border-radius:100px;
  }
  .plan-name{font-family:var(--font-head); font-size:20px; font-weight:700;}
  .plan-price{display:flex; align-items:baseline; gap:6px;}
  .plan-price b{font-family:var(--font-head); font-size:44px;}
  .plan-price span{color:var(--muted); font-size:14px;}
  .plan-features{display:flex; flex-direction:column; gap:12px; font-size:14px; color:#d0d0d0; flex:1;}
  .plan-features li{display:flex; gap:10px; align-items:flex-start;}
  .plan-features li svg{flex-shrink:0; margin-top:3px; color:var(--lime);}
  @media (max-width:900px){ .plans-grid{grid-template-columns:1fr;} }

  /* SCHEDULE */
  .schedule-table{width:100%; border-collapse:collapse; overflow:hidden; border-radius:var(--radius);}
  .schedule-table th{
    background:var(--bg-card-alt); color:var(--lime); font-size:12px; text-transform:uppercase; letter-spacing:.08em;
    padding:16px 14px; text-align:left; font-weight:700;
  }
  .schedule-table td{padding:16px 14px; border-top:1px solid var(--line); font-size:14px; color:#d8d8d8; background:var(--bg-card);}
  .schedule-table tr td:first-child{color:var(--white); font-weight:600;}
  .schedule-wrap{overflow-x:auto; -webkit-overflow-scrolling:touch; border:1px solid var(--line); border-radius:var(--radius);}
  .schedule-table{border-radius:0; min-width:620px;} /* forces horizontal scroll instead of squashed columns on phones */

  /* TRAINERS */
  .trainers-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:18px;}
  .trainer-card{background:var(--bg-card); border-radius:var(--radius); overflow:hidden;}
  .trainer-card img{width:100%; aspect-ratio:3/4; object-fit:cover;}
  .trainer-body{padding:16px 18px 20px;}
  .trainer-body h4{font-size:16px;}
  .trainer-body span{color:var(--lime); font-size:12.5px; font-weight:600;}
  @media (max-width:960px){ .trainers-grid{grid-template-columns:1fr 1fr;} }

  /* MERCH / SHOP */
  .merch-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
  .product-card{background:var(--bg-card); border-radius:var(--radius); overflow:hidden; border:1px solid var(--line);}
  .product-img{aspect-ratio:1/1; background:#101010; display:flex; align-items:center; justify-content:center; overflow:hidden;}
  .product-img img{width:100%; height:100%; object-fit:cover;}
  .product-info{padding:18px;}
  .product-info h4{font-size:15px; margin-bottom:4px;}
  .product-info .price{color:var(--lime); font-weight:700; font-family:var(--font-head); font-size:17px; margin-bottom:12px; display:block;}
  @media (max-width:960px){ .merch-grid{grid-template-columns:1fr 1fr;} }

  /* TESTIMONIALS */
  .testi-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  .testi-card{background:var(--bg-card); border-radius:var(--radius); padding:26px; border:1px solid var(--line);}
  .testi-stars{color:var(--lime); font-size:14px; margin-bottom:14px; letter-spacing:2px;}
  .testi-card p{font-size:14.5px; color:#d6d6d6; margin-bottom:20px;}
  .testi-person{display:flex; align-items:center; gap:12px;}
  .testi-person img{width:44px; height:44px; border-radius:50%; object-fit:cover;}
  .testi-person b{display:block; font-size:14px;}
  .testi-person span{font-size:12px; color:var(--muted);}
  @media (max-width:900px){ .testi-grid{grid-template-columns:1fr;} }

  /* FAQ */
  .faq-list{max-width:760px; margin:0 auto;}
  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{
    width:100%; text-align:left; background:none; border:none; color:var(--white); cursor:pointer;
    padding:22px 4px; display:flex; justify-content:space-between; align-items:center; font-family:var(--font-head); font-size:16px; font-weight:600;
  }
  .faq-q svg{transition:transform .25s ease; flex-shrink:0; color:var(--lime);}
  .faq-item.open .faq-q svg{transform:rotate(45deg);}
  .faq-a{max-height:0; overflow:hidden; transition:max-height .3s ease;}
  .faq-a p{padding:0 4px 22px; color:var(--muted); font-size:14.5px; max-width:640px;}

  /* CONTACT / NEWSLETTER */
  .contact-grid{display:grid; grid-template-columns:1fr 1fr; gap:40px;}
  .form-field{display:flex; flex-direction:column; gap:8px; margin-bottom:16px;}
  .form-field label{font-size:12.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em;}
  .form-field input, .form-field textarea{
    /* font-size must stay >=16px or iOS Safari auto-zooms into the field on focus */
    background:var(--bg-card); border:1px solid var(--line); border-radius:10px; padding:13px 16px;
    color:var(--white); font-family:var(--font-body); font-size:16px; width:100%;
  }
  .form-field input:focus, .form-field textarea:focus{outline:2px solid var(--lime); border-color:var(--lime);}
  .form-note{font-size:12px; color:var(--muted-2); margin-top:10px;}

  /* FINAL CTA */
  .final-cta{
    position:relative; border-radius:var(--radius); overflow:hidden; padding:70px 40px; text-align:left;
    display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;
  }
  .final-cta img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover;}
  .final-cta::after{content:""; position:absolute; inset:0; background:linear-gradient(90deg, rgba(10,10,10,0.92) 30%, rgba(10,10,10,0.5) 100%);}
  .final-cta-content{position:relative; z-index:2;}
  .final-cta h2{font-size:clamp(28px,4vw,40px); margin-bottom:20px;}
  .final-cta-actions{position:relative; z-index:2; display:flex; gap:14px; flex-wrap:wrap;}

  /* FOOTER */
  footer{border-top:1px solid var(--line); padding:50px 0 26px;}
  .footer-top{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:24px; padding-bottom:36px;}
  .footer-links{display:flex; gap:28px; font-size:14px; color:#c9c9c9; flex-wrap:wrap;}
  .footer-links a:hover{color:var(--lime);}
  .footer-social{display:flex; gap:10px;}
  .footer-bottom{
    display:flex; justify-content:space-between; align-items:center; padding-top:24px; border-top:1px solid var(--line);
    font-size:13px; color:var(--muted-2); flex-wrap:wrap; gap:12px;
  }

  /* utility */
  .grid-2{display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center;}
  @media (max-width:860px){ .grid-2{grid-template-columns:1fr;} }
  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(120%);
    background:var(--lime); color:#0a0a0a; padding:14px 22px; border-radius:100px; font-weight:600; font-size:14px;
    transition:transform .35s ease; z-index:2000;
  }
  .toast.show{transform:translateX(-50%) translateY(0);}
  ::selection{background:var(--lime); color:#0a0a0a;}
</style>
</head>
<body>

<!-- ================= HEADER ================= -->
<header>
  <nav class="nav wrap">
    <a href="#top" class="logo">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 12c0-4.4 3.6-8 8-8M20 12c0 4.4-3.6 8-8 8" stroke="#0a0a0a" stroke-width="3" stroke-linecap="round"/></svg>
      </span>
      <span>fitnation<small>GET FIT, LIVE BETTER</small></span>
    </a>
    <ul class="nav-links">
      <li><a href="#services">Services</a></li>
      <li><a href="#facility">Facility</a></li>
      <li><a href="#plans">Membership</a></li>
      <li><a href="#schedule">Schedule</a></li>
      <li><a href="#shop">Merch</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <div class="nav-right">
      <button class="icon-btn snipcart-checkout" aria-label="Cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l2.4 12.2a2 2 0 0 0 2 1.8h7.2a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
      </button>
      <a href="#plans" class="btn btn-lime" style="padding:11px 20px;">Join Now</a>
      <button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </nav>
  <div class="mobile-menu" id="mobileMenu">
    <a href="#services">Services</a>
    <a href="#facility">Facility</a>
    <a href="#plans">Membership</a>
    <a href="#schedule">Schedule</a>
    <a href="#shop">Merch</a>
    <a href="#contact">Contact</a>
  </div>
</header>

<div id="top"></div>

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">FitNation Gym</div>
        <h1>Unleash Your <span>Inner Athlete</span></h1>
